msgid "%(count)s brands"
msgstr "%(count)sটি ব্র্যান্ড"

#, python-format
msgid "%(count)s generics"
msgstr "%(count)sটি জেনেরিক"

msgid "Nothing found."
msgstr "কিছু পাওয়া যায়নি।"

msgid "This information is currently available in Bangla only."
msgstr ""

msgid "What it's for"
msgstr "কেন ব্যবহার করা হয়"

msgid "How to take it"
msgstr "কীভাবে খাবেন"

msgid "Common side effects"
msgstr "সাধারণ পার্শ্বপ্রতিক্রিয়া"

msgid "Warnings"
msgstr "সতর্কতা"

msgid "Source:"
msgstr "সূত্র:"

msgid "Information for this generic has not been added yet."
msgstr "এই জেনেরিকের তথ্য এখনো যোগ করা হয়নি।"

#, python-format
msgid "Brands of %(name)s"
msgstr "%(name)s-এর ব্র্যান্ডসমূহ"

msgid "Filter by name"
msgstr "নাম দিয়ে খুঁজুন"

msgid "Generic"
msgstr "জেনেরিক"

msgid "Strength"
msgstr "শক্তি"

msgid "Form"
msgstr "ধরন"

msgid "Manufacturer"
msgstr "কোম্পানি"

msgid "Price"
msgstr "দাম"

#, python-format
msgid "Price checked: %(date)s"
msgstr "দাম যাচাই: %(date)s"

#, python-format
msgid "What is %(name)s? Uses, side effects, warnings"
msgstr "%(name)s কী? ব্যবহার, পার্শ্বপ্রতিক্রিয়া, সতর্কতা"

msgid "Cheaper alternatives"
msgstr "কম দামের বিকল্প"

#, python-format
msgid "You could save up to %(amount)s"
msgstr "সর্বোচ্চ %(amount)s বাঁচাতে পারেন"

msgid "No cheaper brand found. Other brands with the same generic, strength and form:"
msgstr "এর চেয়ে কম দামের ব্র্যান্ড পাওয়া যায়নি। একই জেনেরিক, শক্তি ও ধরনের অন্য ব্র্যান্ড:"

msgid "No other brand with the same generic, strength and form is listed yet."
msgstr "একই জেনেরিক, শক্তি ও ধরনের অন্য কোনো ব্র্যান্ড এখনো যোগ করা হয়নি।"

msgid "This medicine"
msgstr "এই ওষুধ"

msgid "Same generic, strength and form. Ask your doctor or pharmacist before switching brands."
msgstr "একই জেনেরিক, শক্তি ও ধরন। ব্র্যান্ড বদলানোর আগে ডাক্তার বা ফার্মাসিস্টকে জিজ্ঞেস করুন।"

#, python-format
msgid "%(query)s - search"
msgstr "%(query)s - অনুসন্ধান"

msgid "Type a medicine name to search."
msgstr "খুঁজতে ওষুধের নাম লিখুন।"

#, python-format
msgid "About %(name)s"
msgstr "%(name)s সম্পর্কে জানুন"

#, python-format
msgid "No exact match for \"%(query)s\". Closest matches:"
msgstr "\"%(query)s\" হুবহু পাওয়া যায়নি। কাছাকাছি ফলাফল:"

#, python-format
msgid "Nothing found for \"%(query)s\"."
msgstr "\"%(query)s\" পাওয়া যায়নি।"

msgid "Check the spelling, or try the generic name written on the packet."
msgstr "বানান দেখে নিন, অথবা প্যাকেটে লেখা জেনেরিক নাম দিয়ে খুঁজুন।"

msgid "Medicine information and cheaper alternatives, in one place"
msgstr "ওষুধের তথ্য ও কম দামের বিকল্প, এক জায়গায়"

msgid "We don't have all the prices yet, so we can't say which is cheapest. Other brands with the same generic, strength and form:"
msgstr "সব দাম এখনো আমাদের কাছে নেই, তাই কোনটি সবচেয়ে সস্তা তা বলা যাচ্ছে না। একই জেনেরিক, শক্তি ও ধরনের অন্য ব্র্যান্ড:"

msgid "%(count)s more brands"
msgstr "আরও %(count)sটি ব্র্যান্ড"

msgid "%(count)s registered medicines · %(makers)s companies"
msgstr "%(count)sটি নিবন্ধিত ওষুধ · %(makers)sটি কোম্পানি"

msgid "Cheapest"
msgstr "সবচেয়ে কম দাম"
