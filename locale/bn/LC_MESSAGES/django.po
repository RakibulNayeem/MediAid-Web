msgid "MediAid"
msgstr "মেডিএইড"

msgid "Search for a medicine instead:"
msgstr "এর বদলে ওষুধ খুঁজুন:"

msgid "MediAid - medicine information and emergency help"
msgstr "মেডিএইড - ওষুধের তথ্য ও জরুরি সেবা"

msgid "Find medicine information, cheaper alternatives and emergency help in Bangladesh."
msgstr "বাংলাদেশে ওষুধের তথ্য, কম দামের বিকল্প ও জরুরি সেবা খুঁজুন।"

msgid "Browse"
msgstr "ব্রাউজ করুন"

msgid "Generics"
msgstr "জেনেরিক"

msgid "Manufacturers"
msgstr "কোম্পানি"

msgid "Drug classes"
msgstr "ওষুধের শ্রেণি"

msgid "Emergency"
msgstr "জরুরি"

msgid "MediAid provides information only. It is not medical advice. Always consult a doctor or pharmacist before starting, stopping or changing a medicine."
msgstr "মেডিএইড শুধু তথ্য দেয়, এটি চিকিৎসা পরামর্শ নয়। কোনো ওষুধ শুরু, বন্ধ বা পরিবর্তন করার আগে অবশ্যই ডাক্তার বা ফার্মাসিস্টের পরামর্শ নিন।"

msgid "In an emergency, call 999."
msgstr "জরুরি অবস্থায় ৯৯৯ নম্বরে কল করুন।"

msgid "Search medicines"
msgstr "ওষুধ খুঁজুন"

msgid "Save money"
msgstr "টাকা বাঁচান"

msgid "The same generic, strength and form from another company, at a lower price. Ask your doctor or pharmacist before switching."
msgstr "একই জেনেরিক, একই শক্তি ও একই ধরনের ওষুধ, অন্য কোম্পানির, কম দামে। ব্র্যান্ড বদলানোর আগে ডাক্তার বা ফার্মাসিস্টকে জিজ্ঞেস করুন।"

#, python-format
msgid "Save %(amount)s (%(percent)s%%)"
msgstr "%(amount)s বাঁচান (%(percent)s%%)"

msgid "Sample"
msgstr "নমুনা"

msgid "Commonly searched"
msgstr "বেশি খোঁজা ওষুধ"

msgid "This service is coming soon. If you need urgent help now, call:"
msgstr "এই সেবাটি শিগগিরই আসছে। এখনই জরুরি সাহায্য দরকার হলে কল করুন:"

msgid "999 - National emergency"
msgstr "৯৯৯ - জাতীয় জরুরি সেবা"

msgid "16263 - Health helpline"
msgstr "১৬২৬৩ - স্বাস্থ্য বাতায়ন"

msgid "Information only."
msgstr "শুধু তথ্যের জন্য।"

msgid "This is not medical advice. Consult a doctor or pharmacist before taking or changing any medicine."
msgstr "এটি চিকিৎসা পরামর্শ নয়। কোনো ওষুধ খাওয়া বা বদলানোর আগে ডাক্তার বা ফার্মাসিস্টের পরামর্শ নিন।"

msgid "Price not available"
msgstr "দাম জানা নেই"

msgid "Pages"
msgstr "পেজ"

msgid "Previous"
msgstr "আগের"

msgid "Next"
msgstr "পরের"

msgid "Sample data."
msgstr "নমুনা তথ্য।"

msgid "This entry is for testing. Its details and price are not verified, so do not rely on them."
msgstr "এটি পরীক্ষার জন্য। এর তথ্য ও দাম যাচাই করা হয়নি, তাই এর ওপর নির্ভর করবেন না।"

msgid "Brand or generic name"
msgstr "ওষুধের নাম লিখুন — ব্র্যান্ড বা জেনেরিক"

msgid "Search"
msgstr "খুঁজুন"

msgid "No brands listed yet."
msgstr "এখনো কোনো ব্র্যান্ড যোগ করা হয়নি।"

