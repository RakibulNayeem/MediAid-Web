# Copy this file to .env and fill in the values. NEVER upload .env to GitHub.

# Django
# Make a key with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# Database: leave empty to use a local SQLite file (simplest for trying things out).
# For Neon, paste the *pooled* connection string, e.g.
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Email for account verification and password-reset codes (Gmail works, about 500 a day).
# EMAIL_HOST_PASSWORD is a Google "App password", not your Gmail password.
# Accounts stay switched off on the live site until both are set, because nobody could verify their email.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# "Continue with Google" (optional): Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
